# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# SQLAlchemy connection string. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///careflow.db

# Voice provider selection: "mock" (default, safe for local dev/demo) or "calle"
VOICE_PROVIDER=mock

# CALL-E credentials (only required when VOICE_PROVIDER=calle)
CALLE_API_KEY=
# Confirmed against the documented CALL-E API contract at docs.heycall-e.com.
CALLE_API_BASE_URL=https://api.heycall-e.com
# Currently unused — CALL-E's webhook delivery has no signature/shared-secret
# trust boundary in this integration. Kept blank only as a forward-compatible
# config surface if CALL-E adds a documented signing mechanism later.
CALLE_WEBHOOK_SECRET=
# Optional: only set this if you want CALL-E to call back to a specific
# webhook URL (e.g. an ngrok tunnel during local validation) instead of
# your account's default webhook endpoint. Leave blank to use the default.
CALLE_WEBHOOK_URL=

# Notification channel for escalations: "log" is the only implementation in
# Phase 2 (logs a clearly-labeled notification instead of sending a real
# email/SMS/Slack message). Future values: "smtp", "slack", "sms".
NOTIFICATION_PROVIDER=log

LOG_LEVEL=INFO
